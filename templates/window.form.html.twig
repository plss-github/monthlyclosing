{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {{ fields.textField(
        'name',
        item.fields['name']|default(''),
        __('Nome', 'monthlyclosing'),
        field_options|merge({'readonly': is_locked})
    ) }}

    {% if is_locked %}
        {{ fields.htmlField(
            '_status',
            status_badge,
            __('Status', 'monthlyclosing'),
            field_options
        ) }}
    {% else %}
        {{ fields.dropdownArrayField(
            'status',
            item.fields['status']|default(0),
            editable_statuses,
            __('Status', 'monthlyclosing'),
            field_options
        ) }}
    {% endif %}

    {% if is_locked %}
        {{ fields.readOnlyField(
            'date_start',
            item.fields['date_start']|default('')|formatted_datetime,
            __('Início da janela', 'monthlyclosing'),
            field_options
        ) }}
        {{ fields.readOnlyField(
            'date_end',
            item.fields['date_end']|default('')|formatted_datetime,
            __('Fim da janela', 'monthlyclosing'),
            field_options
        ) }}
    {% else %}
        {{ fields.datetimeField(
            'date_start',
            item.fields['date_start']|default(''),
            __('Início da janela', 'monthlyclosing'),
            field_options|merge({'required': true})
        ) }}
        {{ fields.datetimeField(
            'date_end',
            item.fields['date_end']|default(''),
            __('Fim da janela', 'monthlyclosing'),
            field_options|merge({'required': true})
        ) }}
    {% endif %}

    {% if not item.isNewItem() %}
        {{ fields.readOnlyField(
            'date_activation',
            item.fields['date_activation']|default('')|formatted_datetime,
            __('Ativada em', 'monthlyclosing'),
            field_options
        ) }}
        {{ fields.readOnlyField(
            'date_deactivation',
            item.fields['date_deactivation']|default('')|formatted_datetime,
            __('Desativada em', 'monthlyclosing'),
            field_options
        ) }}
    {% endif %}

    {{ fields.textareaField(
        'comment',
        item.fields['comment']|default(''),
        __('Comentário', 'monthlyclosing'),
        field_options
    ) }}

    {{ fields.hiddenField('_from_form', 1) }}
{% endblock %}
